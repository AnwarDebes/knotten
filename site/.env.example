# Every environment variable the site reads. Copy to .env.local for a computer, or set them in Vercel.
# Empty values are fine for a first local run: records then go to site/data and email is off.

# ---- Storage (src/lib/server/kv.ts): one complete pair switches on Redis; Vercel's Redis integration sets them
# Redis REST address and token (Vercel KV naming)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# The same, with Upstash's own names (used when the KV_* pair is not set)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Start of every Redis key; default "knotten", and "knotten-preview" on Vercel preview deployments
KV_PREFIX=
# Private document storage (Vercel Blob); without it uploads are switched off
BLOB_READ_WRITE_TOKEN=

# ---- Accounts and links
# At least 32 random characters that sign the login sessions (required in production; shorter values are ignored)
AUTH_SECRET=
# The public address, e.g. https://knotten.no: links in emails, robots.txt and the sitemap (required in production)
SITE_URL=
# Your own code for the first-time setup; otherwise one is made and written to the server log (remove after setup)
KNOTTEN_SETUP_CODE=

# ---- Email (src/lib/server/mail.ts): MAIL_FROM plus Resend or SMTP
# Sender, e.g. "Knotten <post@knotten.no>" (with Resend the domain must be verified there)
MAIL_FROM=
# Resend API key
RESEND_API_KEY=
# Any SMTP server instead of Resend, e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
# Tests on a computer only: 1 writes every email to data/private/outbox as an .eml file instead of sending it
MAIL_DEV_OUTBOX=

# ---- Spam protection on the interest forms (Cloudflare Turnstile); both or neither
# Secret key, used by the server to check each answer
TURNSTILE_SECRET_KEY=
# Site key, shown to the browser
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Scheduled jobs (vercel.json): the weekly summary and the nightly cleanup
# A long random text that Vercel Cron sends as a bearer token; without it the jobs do not run
CRON_SECRET=

# ---- Knotten AI (optional): answers beyond the project's own data from a hosted language model
# API key for the language model provider (the privacy page names the provider when this is set)
ANTHROPIC_API_KEY=
# The model's name
KNOTTEN_AI_MODEL=
# Older name for the model's name, read when KNOTTEN_AI_MODEL is empty
ANTHROPIC_MODEL=

# ---- Set by the platform, read by the site; never set these yourself (kept as comments)
# Set on every Vercel deployment; without a database it switches storage to "temp" (nothing is saved)
# VERCEL=
# production, preview or development; preview deployments get their own KV_PREFIX
# VERCEL_ENV=
# Vercel's production domain, used for links in emails when SITE_URL is empty
# VERCEL_PROJECT_PRODUCTION_URL=
# The region the function runs in, shown by /api/health
# VERCEL_REGION=
# The deployed commit, shown by /api/health as the version
# VERCEL_GIT_COMMIT_SHA=
# Set by Next: production for next build and next start (secure cookies, no setup code on the page)
# NODE_ENV=
