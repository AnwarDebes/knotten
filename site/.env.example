# Every environment variable the site reads. Copy to .env.local for a computer, or set them in Vercel.
# Empty values are fine for a first local run: records then go to site/data and email is off.

# ---- Storage (src/lib/server/kv.ts): one complete pair switches on Redis
# The Redis database's REST address and token. Vercel sets this pair when an Upstash Redis database is connected
# to the project with the environment variable prefix KV
KV_REST_API_URL=
KV_REST_API_TOKEN=
# The same pair under Upstash's own names, read when the KV pair is not complete
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Start of every Redis key; default "knotten", and "knotten-preview" on Vercel preview deployments
KV_PREFIX=
# Private document storage (Vercel Blob, src/lib/server/files.ts), set by Vercel when a Blob store is connected to
# the project: older stores get the token, newer ones the store id (the deployment then signs in with its own OIDC
# token, which Vercel provides). Either one switches uploads on; without both they are off, except on a computer
# without Redis, where files go to site/data/private/files
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# ---- Accounts and links
# At least 32 random characters that sign the login sessions (a shorter value is ignored). Without it the site
# signs with a key it makes itself and keeps with the accounts; the portal asks for this one in production.
# Setting or changing it ends every session: everyone logs in again
AUTH_SECRET=
# The public address, e.g. https://knotten.no: links in emails, link previews, robots.txt and the sitemap.
# Without it Vercel's production domain is used. Build again after changing it (the static pages keep the address)
SITE_URL=
# Your own code for the first-time setup; otherwise one is made and written to the server log (remove after setup)
KNOTTEN_SETUP_CODE=

# ---- Email (src/lib/server/mail.ts): MAIL_FROM plus Resend or SMTP
# Sender, e.g. "Knotten <post@knotten.no>" (with Resend the domain must be verified there)
MAIL_FROM=
# Resend API key
RESEND_API_KEY=
# Any SMTP server instead of Resend, e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
# Tests on a computer only: 1 writes every email to data/private/outbox as an .eml file instead of sending it
MAIL_DEV_OUTBOX=

# ---- Spam protection on the public forms (Cloudflare Turnstile); both or neither
# Secret key, used by the server to check each answer
TURNSTILE_SECRET_KEY=
# Site key, shown to the browser (read when the site is built: build again after changing it)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Scheduled jobs (vercel.json): the weekly summary and the nightly cleanup
# A long random text that Vercel Cron sends as a bearer token; without it the jobs do not run
CRON_SECRET=

# ---- Knotten AI (optional, src/lib/server/assistant.ts): a hosted language model for questions the project's
# own data does not cover. Without the key and the model's name, Knotten AI answers from the data only
# API key for the language model provider (the privacy page names the provider while this is on)
ANTHROPIC_API_KEY=
# The model's name, kept here and nowhere in the code
KNOTTEN_AI_MODEL=
# Older name for the same, read when KNOTTEN_AI_MODEL is empty
ANTHROPIC_MODEL=
# Most answers a day from the language model (Norwegian time): 200 when the variable is not set at all;
# 0 or an empty value switches the language model off
KNOTTEN_AI_DAILY_LIMIT=200

# ---- Set by the platform, read by the site; never set these yourself (kept as comments)
# Set on every Vercel deployment; without a database it switches storage to "temp" (nothing is saved)
# VERCEL=
# production, preview or development; preview deployments get their own KV_PREFIX
# VERCEL_ENV=
# Vercel's production domain, used for links and addresses when SITE_URL is empty
# VERCEL_PROJECT_PRODUCTION_URL=
# The region the function runs in, shown by /api/health
# VERCEL_REGION=
# The deployed commit, shown by /api/health as the version
# VERCEL_GIT_COMMIT_SHA=
# Set by npm when the site is started with npm run; /api/health shows it as the version when there is no commit
# npm_package_version=
# Set by Next: production for next build and next start (secure cookies, no setup code on the page)
# NODE_ENV=
